    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 220\" aria-hidden=\"true\">\n        <rect class=\"diagram-node is-focal\" x=\"18\" y=\"42\" width=\"108\" height=\"120\" rx=\"4\"/><line class=\"diagram-gridline\" x1=\"18\" y1=\"72\" x2=\"126\" y2=\"72\"/><text class=\"diagram-label\" x=\"72\" y=\"57\">Outcome</text><text class=\"diagram-label is-small\" x=\"72\" y=\"90\">id · primary</text><text class=\"diagram-label is-small\" x=\"72\" y=\"116\">title</text><text class=\"diagram-label is-small\" x=\"72\" y=\"142\">layout</text>\n        <rect class=\"diagram-node\" x=\"194\" y=\"42\" width=\"108\" height=\"120\" rx=\"4\"/><line class=\"diagram-gridline\" x1=\"194\" y1=\"72\" x2=\"302\" y2=\"72\"/><text class=\"diagram-label\" x=\"248\" y=\"57\">Section</text><text class=\"diagram-label is-small\" x=\"248\" y=\"90\">id · primary</text><text class=\"diagram-label is-small\" x=\"248\" y=\"116\">outcome_id</text><text class=\"diagram-label is-small\" x=\"248\" y=\"142\">position</text>\n        <line class=\"diagram-edge\" x1=\"126\" y1=\"102\" x2=\"194\" y2=\"102\"/><text class=\"diagram-label\" x=\"142\" y=\"92\">1</text><text class=\"diagram-label\" x=\"178\" y=\"92\">N</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">One Outcome owns many ordered Sections through the outcome identifier.</figcaption>"
