  {
    "id": "swimlane",
    "title": "Swimlane",
    "use": "A process crossing responsibilities or system boundaries.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 220\" aria-hidden=\"true\">\n        <defs><marker id=\"swimlane-arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M0 0 10 5 0 10Z\" fill=\"var(--a40)\"/></marker></defs>\n        <rect class=\"diagram-node\" x=\"10\" y=\"12\" width=\"300\" height=\"58\" rx=\"5\"/><rect class=\"diagram-node\" x=\"10\" y=\"80\" width=\"300\" height=\"58\" rx=\"5\"/><rect class=\"diagram-node\" x=\"10\" y=\"148\" width=\"300\" height=\"58\" rx=\"5\"/>\n        <text class=\"diagram-label is-small\" x=\"46\" y=\"41\">author</text><text class=\"diagram-label is-small\" x=\"46\" y=\"109\">CI</text><text class=\"diagram-label is-small\" x=\"46\" y=\"177\">release</text>\n        <rect class=\"diagram-node\" x=\"86\" y=\"24\" width=\"66\" height=\"34\" rx=\"5\"/><text class=\"diagram-label is-small\" x=\"119\" y=\"41\">commit</text>\n        <rect class=\"diagram-node is-focal\" x=\"150\" y=\"92\" width=\"70\" height=\"34\" rx=\"5\"/><text class=\"diagram-label is-small\" x=\"185\" y=\"109\">verify</text>\n        <rect class=\"diagram-node\" x=\"220\" y=\"160\" width=\"70\" height=\"34\" rx=\"5\"/><text class=\"diagram-label is-small\" x=\"255\" y=\"177\">publish</text>\n        <path class=\"diagram-edge\" d=\"M152 41 C176 41 164 78 176 88M220 109 C248 109 238 144 248 156\" marker-end=\"url(#swimlane-arrow)\"/>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">The author commits, CI owns verification, and release owns publication.</figcaption>"
  },
  {
    "id": "tree",
    "title": "Tree",
    "use": "Parent-child hierarchy such as modules, teams, or directories.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 200\" aria-hidden=\"true\">\n        <path class=\"diagram-edge\" d=\"M160 52V78M64 78H256M64 78V104M160 78V104M256 78V104M64 138V160M256 138V160\"/>\n        <rect class=\"diagram-node is-focal\" x=\"120\" y=\"18\" width=\"80\" height=\"34\" rx=\"5\"/><text class=\"diagram-label\" x=\"160\" y=\"35\">root</text>\n        <rect class=\"diagram-node\" x=\"24\" y=\"104\" width=\"80\" height=\"34\" rx=\"5\"/><text class=\"diagram-label\" x=\"64\" y=\"121\">surface</text>\n        <rect class=\"diagram-node\" x=\"120\" y=\"104\" width=\"80\" height=\"34\" rx=\"5\"/><text class=\"diagram-label\" x=\"160\" y=\"121\">runtime</text>\n        <rect class=\"diagram-node\" x=\"216\" y=\"104\" width=\"80\" height=\"34\" rx=\"5\"/><text class=\"diagram-label\" x=\"256\" y=\"121\">proof</text>\n        <text class=\"diagram-label is-small\" x=\"64\" y=\"178\">web · app</text><text class=\"diagram-label is-small\" x=\"256\" y=\"178\">tests · logs</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">The root separates the surface, runtime, and proof domains.</figcaption>"
  },
  {
    "id": "layer-stack",
