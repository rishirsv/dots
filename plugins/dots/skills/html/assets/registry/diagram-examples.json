[
  {
    "id": "architecture",
    "title": "Architecture",
    "use": "System components and their principal connections.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 180\" aria-hidden=\"true\">\n        <defs><marker id=\"architecture-arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M0 0 10 5 0 10Z\" fill=\"var(--a40)\"/></marker></defs>\n        <path class=\"diagram-edge\" d=\"M76 90H116M204 90H244M160 68V42\" marker-end=\"url(#architecture-arrow)\"/>\n        <rect class=\"diagram-node\" x=\"16\" y=\"68\" width=\"60\" height=\"44\" rx=\"6\"/><text class=\"diagram-label\" x=\"46\" y=\"90\">client</text>\n        <rect class=\"diagram-node is-focal\" x=\"116\" y=\"68\" width=\"88\" height=\"44\" rx=\"6\"/><text class=\"diagram-label\" x=\"160\" y=\"90\">service</text>\n        <rect class=\"diagram-node\" x=\"244\" y=\"68\" width=\"60\" height=\"44\" rx=\"6\"/><text class=\"diagram-label\" x=\"274\" y=\"90\">store</text>\n        <rect class=\"diagram-node\" x=\"122\" y=\"10\" width=\"76\" height=\"32\" rx=\"6\"/><text class=\"diagram-label is-small\" x=\"160\" y=\"26\">policy</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">The client enters one focal service, which reads the store under a policy boundary.</figcaption>"
  },
  {
    "id": "architecture-board",
    "title": "Architecture board",
    "use": "A full-system panorama with layers, path, and ownership.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 220\" aria-hidden=\"true\">\n        <rect class=\"diagram-node\" x=\"14\" y=\"14\" width=\"292\" height=\"34\" rx=\"5\"/><text class=\"diagram-label\" x=\"160\" y=\"31\">roles · operators · consumers</text>\n        <rect class=\"diagram-node\" x=\"14\" y=\"58\" width=\"292\" height=\"52\" rx=\"5\"/><line class=\"diagram-gridline\" x1=\"111\" y1=\"58\" x2=\"111\" y2=\"110\"/><line class=\"diagram-gridline\" x1=\"209\" y1=\"58\" x2=\"209\" y2=\"110\"/><text class=\"diagram-label\" x=\"62\" y=\"84\">surface</text><text class=\"diagram-label\" x=\"160\" y=\"84\">runtime</text><text class=\"diagram-label\" x=\"258\" y=\"84\">control</text>\n        <rect class=\"diagram-node is-focal\" x=\"14\" y=\"120\" width=\"292\" height=\"36\" rx=\"5\"/><text class=\"diagram-label\" x=\"160\" y=\"138\">primary execution path</text>\n        <rect class=\"diagram-node\" x=\"14\" y=\"166\" width=\"292\" height=\"40\" rx=\"5\"/><text class=\"diagram-label\" x=\"160\" y=\"186\">owners · proof · next intervention</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">Four bands separate who uses the system, what runs, the main path, and who owns the next change.</figcaption>"
  },
