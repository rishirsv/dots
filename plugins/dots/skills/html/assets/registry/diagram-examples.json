    "id": "quadrant",
    "title": "Quadrant",
    "use": "Position items against two independent criteria.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 180\" aria-hidden=\"true\">\n        <line class=\"diagram-gridline\" x1=\"42\" y1=\"144\" x2=\"298\" y2=\"144\"/><line class=\"diagram-gridline\" x1=\"42\" y1=\"144\" x2=\"42\" y2=\"18\"/>\n        <line class=\"diagram-gridline\" x1=\"170\" y1=\"18\" x2=\"170\" y2=\"144\"/><line class=\"diagram-gridline\" x1=\"42\" y1=\"81\" x2=\"298\" y2=\"81\"/>\n        <circle cx=\"236\" cy=\"48\" r=\"9\" fill=\"var(--accent)\"/><text class=\"diagram-label is-small\" x=\"236\" y=\"30\">A</text>\n        <circle cx=\"112\" cy=\"62\" r=\"7\" fill=\"var(--a40)\"/><text class=\"diagram-label is-small\" x=\"112\" y=\"44\">B</text>\n        <circle cx=\"220\" cy=\"116\" r=\"7\" fill=\"var(--a40)\"/><text class=\"diagram-label is-small\" x=\"220\" y=\"98\">C</text>\n        <text class=\"diagram-label is-small\" x=\"170\" y=\"164\">effort →</text><text class=\"diagram-label is-small\" transform=\"translate(18 82) rotate(-90)\">impact →</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">Option A combines the highest impact with above-average effort.</figcaption>"
  },
