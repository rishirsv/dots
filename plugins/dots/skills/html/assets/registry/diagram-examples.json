    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 180\" aria-hidden=\"true\">\n        <circle cx=\"128\" cy=\"86\" r=\"58\" fill=\"var(--accent)\" fill-opacity=\".10\" stroke=\"var(--accent)\" stroke-width=\"2\"/>\n        <circle cx=\"192\" cy=\"86\" r=\"58\" fill=\"var(--a20)\" stroke=\"var(--a40)\" stroke-width=\"2\"/>\n        <text class=\"diagram-label\" x=\"104\" y=\"82\">speed</text><text class=\"diagram-label\" x=\"216\" y=\"82\">proof</text><text class=\"diagram-label is-small\" x=\"160\" y=\"104\">release</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">The release path is the overlap between fast execution and durable proof.</figcaption>"
  },
  {
    "id": "candlestick",
    "title": "Candlestick",
    "use": "Open-high-low-close movement where ranges matter.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 180\" aria-hidden=\"true\">\n        <line class=\"diagram-gridline\" x1=\"28\" y1=\"146\" x2=\"300\" y2=\"146\"/><line class=\"diagram-gridline\" x1=\"28\" y1=\"28\" x2=\"28\" y2=\"146\"/>\n        <g stroke-width=\"2\"><line x1=\"66\" y1=\"46\" x2=\"66\" y2=\"126\" stroke=\"var(--a40)\"/><rect x=\"56\" y=\"68\" width=\"20\" height=\"34\" fill=\"var(--background)\" stroke=\"var(--a40)\"/>\n        <line x1=\"112\" y1=\"54\" x2=\"112\" y2=\"138\" stroke=\"var(--accent)\"/><rect x=\"102\" y=\"84\" width=\"20\" height=\"30\" fill=\"var(--accent)\" stroke=\"var(--accent)\"/>\n        <line x1=\"158\" y1=\"34\" x2=\"158\" y2=\"118\" stroke=\"var(--a40)\"/><rect x=\"148\" y=\"54\" width=\"20\" height=\"38\" fill=\"var(--background)\" stroke=\"var(--a40)\"/>\n        <line x1=\"204\" y1=\"60\" x2=\"204\" y2=\"142\" stroke=\"var(--accent)\"/><rect x=\"194\" y=\"84\" width=\"20\" height=\"34\" fill=\"var(--accent)\" stroke=\"var(--accent)\"/>\n        <line x1=\"250\" y1=\"28\" x2=\"250\" y2=\"110\" stroke=\"var(--a40)\"/><rect x=\"240\" y=\"48\" width=\"20\" height=\"36\" fill=\"var(--background)\" stroke=\"var(--a40)\"/></g>\n        <text class=\"diagram-label is-small\" x=\"160\" y=\"164\">five periods</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">The five-period series alternates down and up closes while the overall high moves upward.</figcaption>"
  },
  {
    "id": "waterfall",
    "title": "Waterfall",
    "use": "Explain how additions and deductions bridge two totals.",
    "markup": "<div class=\"diagram-scroll\"><svg class=\"diagram-canvas\" viewBox=\"0 0 320 180\" aria-hidden=\"true\">\n        <line class=\"diagram-gridline\" x1=\"24\" y1=\"146\" x2=\"302\" y2=\"146\"/>\n        <rect x=\"34\" y=\"86\" width=\"42\" height=\"60\" fill=\"var(--a40)\"/><text class=\"diagram-value\" x=\"55\" y=\"78\">100</text>\n        <rect x=\"88\" y=\"58\" width=\"42\" height=\"28\" fill=\"var(--accent)\"/><line class=\"diagram-gridline\" x1=\"76\" y1=\"86\" x2=\"88\" y2=\"86\"/><text class=\"diagram-value\" x=\"109\" y=\"50\">+24</text>\n        <rect x=\"142\" y=\"58\" width=\"42\" height=\"18\" fill=\"var(--a20)\"/><line class=\"diagram-gridline\" x1=\"130\" y1=\"58\" x2=\"142\" y2=\"58\"/><text class=\"diagram-value\" x=\"163\" y=\"92\">−18</text>\n        <rect x=\"196\" y=\"40\" width=\"42\" height=\"36\" fill=\"var(--accent)\"/><line class=\"diagram-gridline\" x1=\"184\" y1=\"76\" x2=\"196\" y2=\"76\"/><text class=\"diagram-value\" x=\"217\" y=\"32\">+32</text>\n        <rect x=\"250\" y=\"40\" width=\"42\" height=\"106\" fill=\"var(--foreground)\"/><text class=\"diagram-value\" x=\"271\" y=\"30\">138</text>\n      </svg></div>\n      <figcaption class=\"diagram-summary\">A starting value of 100 reaches 138 after additions of 24 and 32 offset an 18-point deduction.</figcaption>"
  },
