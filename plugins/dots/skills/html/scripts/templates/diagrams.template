<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diagram atlas</title>
<style>
__DOTS_THEME_CSS__

.page {
    max-width: var(--article);
    margin: 0 auto;
    padding: 64px 24px 96px;
  }
  .page[data-layout="wide"] { max-width: var(--wide); }
  .page[data-layout="canvas"] { max-width: var(--canvas); }
  .reading-column { max-width: var(--article); }
  .page[data-layout="article"] .reading-column,
  .page[data-layout="wide"] .reading-column { margin-right: auto; }
  .page[data-layout="canvas"] .reading-column { margin-left: auto; margin-right: auto; }
  .page > header { margin-bottom: var(--section); }
  .context-line { font-size: 13px; color: var(--text-muted); margin: 0 0 20px; }
  .title-row { margin-bottom: 8px; }
  .dek { font-size: 16px; color: var(--text-muted); margin: 0; max-width: 62ch; }
  footer.sources {
    margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--a12);
    font-size: 12px; color: var(--text-muted); line-height: 1.7;
  }
  footer.sources a { color: var(--text-muted); }
  @media (max-width: 680px) {
    .page { padding: 40px 24px 72px; }
  }
</style>
</head>
<body>
<div data-component="page-shell" class="page" data-layout="canvas">
  <header class="stagger">
    <p class="context-line">dots html / visual vocabulary</p>
    <div class="title-row">
      <h1>Diagram atlas</h1>

    </div>
    <p class="dek">Nineteen reusable templates for structure, process, hierarchy, interaction, and quantitative explanation.</p>
  </header>

  <style>
    .diagram-intro { margin-bottom: var(--section); }
    .diagram-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .diagram-card {
      min-width: 0;
      margin: 0;
      padding: 18px;
      border: 1px solid var(--a12);
      border-radius: var(--r-card);
      background: var(--background);
    }
    .diagram-card h2 { font-size: 18px; line-height: 24px; margin-bottom: 4px; }
    .diagram-use { color: var(--text-muted); font-size: 13px; margin-bottom: 14px; }
    .diagram-scroll { overflow-x: auto; overscroll-behavior-inline: contain; }
    .diagram-canvas {
      display: block;
      width: 100%;
      height: auto;
      min-width: 320px;
      border: 1px solid var(--a8);
      border-radius: var(--r-card);
      background: var(--a4);
    }
    .diagram-node { fill: var(--background); stroke: var(--a40); stroke-width: 1.5; }
    .diagram-node.is-focal { fill: var(--a4); stroke: var(--accent); stroke-width: 2; }
    .diagram-edge { fill: none; stroke: var(--a40); stroke-width: 1.5; }
    .diagram-edge.is-focal { stroke: var(--accent); stroke-width: 2; }
    .diagram-gridline { stroke: var(--a12); stroke-width: 1; }
    .diagram-label {
      fill: var(--foreground);
      font-family: var(--font-sans);
      font-size: 14px;
      text-anchor: middle;
      dominant-baseline: middle;
    }
    .diagram-label.is-small { fill: var(--text-muted); font-size: 12px; }
    .diagram-value {
      fill: var(--foreground);
      font-family: var(--font-mono);
      font-size: 13px;
      text-anchor: middle;
    }
    .diagram-summary {
      color: var(--text-muted);
      font-size: 13px;
      line-height: 1.55;
      margin: 12px 0 0;
    }
    @media (max-width: 760px) {
      .diagram-grid { grid-template-columns: 1fr; }
    }
  </style>
<style>
  .flow-diagram-wrap {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-gutter: stable;
    margin-bottom: 12px;
  }

  .flow-diagram {
    display: block;
    width: 100%;
    height: auto;
    min-width: 560px;
  }

  .flow-node-rect {
    fill: var(--background);
    stroke: var(--a40);
    stroke-width: 1.5;
  }

  .flow-node-rect.is-emphasized {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .flow-node-label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--foreground);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .flow-edge {
    fill: none;
    stroke: var(--a40);
    stroke-width: 1.5;
  }

  .flow-edge-label {
    font-size: 13px;
    fill: var(--a55);
    text-anchor: middle;
  }

  .flow-caption {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .flow-callout {
    fill: var(--accent);
    stroke: var(--background);
    stroke-width: 2;
  }
  .flow-callout-label {
    fill: var(--background);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .flow-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 16px 0 0;
    margin: 0;
    list-style: none;
    counter-reset: flow-note;
  }
  .flow-notes li {
    counter-increment: flow-note;
    font-size: 13px;
    color: var(--text-muted);
  }
  .flow-notes li::before {
    content: counter(flow-note);
    display: block;
    color: var(--accent-deep);
    font-weight: 600;
    margin-bottom: 4px;
  }
  @media (max-width: 680px) {
    .flow-notes { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
<style>
  .chart-card {
    border: 1px solid var(--a12);
    border-radius: var(--r-card);
    padding: 20px 20px 16px;
    margin-bottom: var(--section);
  }

  .chart-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .bar-row:last-child { margin-bottom: 0; }

  .bar-name {
    width: 148px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--text-muted);
  }

  .bar-track {
    flex: 1;
    background: var(--a4);
    border-radius: 4px;
    height: 18px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .bar-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--a20);
  }

  .bar-fill.emphasis { background: var(--accent); }

  .bar-value {
    width: 56px;
    text-align: right;
    flex-shrink: 0;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
</style>
<style>
  .chart-scroll { overflow-x: auto; }
  .chart-scroll svg { display: block; width: 100%; height: auto; }
  .chart-scroll svg text { fill: var(--text-muted); font: 12px var(--font-sans); }
  .line-series { fill: none; stroke: var(--accent); stroke-width: 2; }
  .line-point { fill: var(--accent); }
</style>
<style>
  .stacked-row { display:grid; grid-template-columns:120px minmax(0,1fr) 48px; gap:12px; align-items:center; margin:0 0 12px; font-size:13px; }
  .stacked-track { display:flex; height:18px; background:var(--a4); border-radius:4px; overflow:hidden; }
  .stacked-segment { display:block; height:100%; }
  .series-0 { background:var(--accent); }
  .series-1 { background:var(--a40); }
  .series-2 { background:var(--a20); }
  .series-3 { background:var(--a12); }
  .stacked-legend { display:flex; flex-wrap:wrap; gap:12px; font-size:12px; color:var(--text-muted); }
  .stacked-legend span { display:inline-flex; align-items:center; gap:5px; }
  .stacked-legend i { display:inline-block; width:10px; height:10px; }
</style>
<style>.diagram-card .chart-card{border:0;padding:0;margin:0}.diagram-card .flow-diagram-wrap{margin:0}.diagram-card:is([data-diagram="flowchart"],[data-diagram="state-machine"],[data-diagram="sequence"],[data-diagram="timeline"],[data-diagram="line-chart"]){grid-column:1/-1}</style>

  <div class="reading-column diagram-intro">
    <section id="choose">
      <h2>Choose the relationship before drawing</h2>
      <p>These 19 templates cover system structure, process, hierarchy, interaction, and quantitative explanation. Copy the closest figure, keep the shared visual rules, and replace every illustrative label with grounded content.</p>
      <p>Use a table for a binary comparison and prose when the diagram would only put a box around a sentence.</p>
    </section>
  </div>

  <div class="diagram-grid">
    <figure id="architecture" class="diagram-card" data-diagram="architecture">
      <h2>Architecture</h2>
      <p class="diagram-use">System components and their principal connections.</p>
      <div class="diagram-scroll"><svg class="diagram-canvas" viewBox="0 0 320 180" aria-hidden="true">
        <defs><marker id="architecture-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 10 5 0 10Z" fill="var(--a40)"/></marker></defs>
        <path class="diagram-edge" d="M76 90H116M204 90H244M160 68V42" marker-end="url(#architecture-arrow)"/>
        <rect class="diagram-node" x="16" y="68" width="60" height="44" rx="6"/><text class="diagram-label" x="46" y="90">client</text>
        <rect class="diagram-node is-focal" x="116" y="68" width="88" height="44" rx="6"/><text class="diagram-label" x="160" y="90">service</text>
        <rect class="diagram-node" x="244" y="68" width="60" height="44" rx="6"/><text class="diagram-label" x="274" y="90">store</text>
        <rect class="diagram-node" x="122" y="10" width="76" height="32" rx="6"/><text class="diagram-label is-small" x="160" y="26">policy</text>
      </svg></div>
      <figcaption class="diagram-summary">The client enters one focal service, which reads the store under a policy boundary.</figcaption>
    </figure>

    <figure id="architecture-board" class="diagram-card" data-diagram="architecture-board">
      <h2>Architecture board</h2>
      <p class="diagram-use">A full-system panorama with layers, path, and ownership.</p>
      <div class="diagram-scroll"><svg class="diagram-canvas" viewBox="0 0 320 220" aria-hidden="true">
        <rect class="diagram-node" x="14" y="14" width="292" height="34" rx="5"/><text class="diagram-label" x="160" y="31">roles · operators · consumers</text>
        <rect class="diagram-node" x="14" y="58" width="292" height="52" rx="5"/><line class="diagram-gridline" x1="111" y1="58" x2="111" y2="110"/><line class="diagram-gridline" x1="209" y1="58" x2="209" y2="110"/><text class="diagram-label" x="62" y="84">surface</text><text class="diagram-label" x="160" y="84">runtime</text><text class="diagram-label" x="258" y="84">control</text>
        <rect class="diagram-node is-focal" x="14" y="120" width="292" height="36" rx="5"/><text class="diagram-label" x="160" y="138">primary execution path</text>
        <rect class="diagram-node" x="14" y="166" width="292" height="40" rx="5"/><text class="diagram-label" x="160" y="186">owners · proof · next intervention</text>
      </svg></div>
      <figcaption class="diagram-summary">Four bands separate who uses the system, what runs, the main path, and who owns the next change.</figcaption>
    </figure>

    <figure id="flowchart" class="diagram-card" data-diagram="flowchart">
      <h2>Flowchart</h2>
      <p class="diagram-use">A decision branch where each edge changes the outcome.</p>
      <!-- GENERATED from report helpers by diagram-examples.mjs -->
      <div data-component="flow-diagram" class="flow-diagram-wrap"><svg class="flow-diagram" viewBox="0 0 588 296" style="min-width:588px" aria-hidden="true"><defs><marker id="dots-flow-1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10Z" fill="var(--a40)"/></marker></defs><path class="flow-edge" d="M144,95 H189 V95 H228" marker-end="url(#dots-flow-1-arrow)"/><path class="flow-edge" d="M354,95 H399 V48 H438" marker-end="url(#dots-flow-1-arrow)"/><text class="flow-edge-label" x="399" y="40">yes</text><path class="flow-edge" d="M354,95 H399 V142 H438" marker-end="url(#dots-flow-1-arrow)"/><text class="flow-edge-label" x="399" y="87">no</text><rect class="flow-node-rect" x="24" y="71" width="120" height="48" rx="8"/><text class="flow-node-label" x="84" y="95">input</text><rect class="flow-node-rect is-emphasized" x="234" y="71" width="120" height="48" rx="8"/><text class="flow-node-label" x="294" y="95">valid?</text><rect class="flow-node-rect" x="444" y="24" width="120" height="48" rx="8"/><text class="flow-node-label" x="504" y="48">accept</text><rect class="flow-node-rect" x="444" y="118" width="120" height="48" rx="8"/><text class="flow-node-label" x="504" y="142">repair</text></svg></div><p class="flow-caption">Input is accepted when valid; otherwise it enters a repair path.</p>
    </figure>

    <figure id="quadrant" class="diagram-card" data-diagram="quadrant">
      <h2>Quadrant</h2>
      <p class="diagram-use">Position items against two independent criteria.</p>
      <div class="diagram-scroll"><svg class="diagram-canvas" viewBox="0 0 320 180" aria-hidden="true">
        <line class="diagram-gridline" x1="42" y1="144" x2="298" y2="144"/><line class="diagram-gridline" x1="42" y1="144" x2="42" y2="18"/>
        <line class="diagram-gridline" x1="170" y1="18" x2="170" y2="144"/><line class="diagram-gridline" x1="42" y1="81" x2="298" y2="81"/>
        <circle cx="236" cy="48" r="9" fill="var(--accent)"/><text class="diagram-label is-small" x="236" y="30">A</text>
        <circle cx="112" cy="62" r="7" fill="var(--a40)"/><text class="diagram-label is-small" x="112" y="44">B</text>
        <circle cx="220" cy="116" r="7" fill="var(--a40)"/><text class="diagram-label is-small" x="220" y="98">C</text>
        <text class="diagram-label is-small" x="170" y="164">effort →</text><text class="diagram-label is-small" transform="translate(18 82) rotate(-90)">impact →</text>
      </svg></div>
      <figcaption class="diagram-summary">Option A combines the highest impact with above-average effort.</figcaption>
    </figure>

    <figure id="bar-chart" class="diagram-card" data-diagram="bar-chart">
      <h2>Bar chart</h2>
      <p class="diagram-use">Compare category magnitudes with one meaningful emphasis.</p>
      <div class="diagram-scroll"><svg class="diagram-canvas" viewBox="0 0 320 180" aria-hidden="true">
        <text class="diagram-label is-small" x="48" y="38">alpha</text><rect x="82" y="26" width="154" height="20" rx="3" fill="var(--a20)"/><text class="diagram-value" x="254" y="41">68</text>
        <text class="diagram-label is-small" x="48" y="78">beta</text><rect x="82" y="66" width="202" height="20" rx="3" fill="var(--accent)"/><text class="diagram-value" x="298" y="81">89</text>
        <text class="diagram-label is-small" x="48" y="118">gamma</text><rect x="82" y="106" width="118" height="20" rx="3" fill="var(--a20)"/><text class="diagram-value" x="218" y="121">52</text>
        <text class="diagram-label is-small" x="48" y="158">delta</text><rect x="82" y="146" width="78" height="20" rx="3" fill="var(--a20)"/><text class="diagram-value" x="178" y="161">34</text>
      </svg></div>
      <figcaption class="diagram-summary">Beta leads the four supplied categories at 89.</figcaption>
    </figure>

    <figure id="line-chart" class="diagram-card" data-diagram="line-chart">
      <h2>Line chart</h2>
      <p class="diagram-use">Show a time series whose direction and inflections matter.</p>
      <!-- GENERATED from report helpers by diagram-examples.mjs -->
      <div data-component="line-chart" data-source="illustrative" class="chart-card reveal">
<!-- chart-spec {"type":"line","title":"Seven-week trend","data":[["W1",100],["W2",120],["W3",115],["W4",148],["W5",166],["W6",183],["W7",174]],"sort":"none"} -->
  <div class="chart-title">Seven-week trend</div>
  <div class="chart-scroll"><svg viewBox="0 0 640 250" style="min-width:640px" aria-hidden="true"><polyline class="line-series" points="44,190 137.33,153.86 230.67,162.89 324,103.25 417.33,70.72 510.67,40 604,56.27"/><circle class="line-point" cx="44" cy="190" r="4"/><circle class="line-point" cx="137.33" cy="153.86" r="4"/><circle class="line-point" cx="230.67" cy="162.89" r="4"/><circle class="line-point" cx="324" cy="103.25" r="4"/><circle class="line-point" cx="417.33" cy="70.72" r="4"/><circle class="line-point" cx="510.67" cy="40" r="4"/><circle class="line-point" cx="604" cy="56.27" r="4"/><text x="44" y="230" text-anchor="middle">W1</text><text x="137.33" y="230" text-anchor="middle">W2</text><text x="230.67" y="230" text-anchor="middle">W3</text><text x="324" y="230" text-anchor="middle">W4</text><text x="417.33" y="230" text-anchor="middle">W5</text><text x="510.67" y="230" text-anchor="middle">W6</text><text x="604" y="230" text-anchor="middle">W7</text></svg></div>
</div>
      <figcaption class="diagram-summary">The measure rises overall, with a third-week reversal and a final-week pullback.</figcaption>
    </figure>

    <figure id="stacked-chart" class="diagram-card" data-diagram="stacked-chart"><h2>Stacked chart</h2><p class="diagram-use">Compare the composition of totals across categories.</p>
      <!-- GENERATED from report helpers by diagram-examples.mjs -->
      <div data-component="stacked-chart" data-source="illustrative" class="chart-card reveal">
<!-- chart-spec {"type":"stacked","title":"Completed and pending work","series":["Done","Pending"],"data":[["Search",5,2],["Checkout",3,4],["Auth",6,1]]} -->
  <div class="chart-title">Completed and pending work</div>
  <div class="stacked-row"><span>Search</span><div class="stacked-track"><span class="stacked-segment series-0" style="width:71.43%" title="Done: 5"></span><span class="stacked-segment series-1" style="width:28.57%" title="Pending: 2"></span></div><span>7</span></div>
  <div class="stacked-row"><span>Checkout</span><div class="stacked-track"><span class="stacked-segment series-0" style="width:42.86%" title="Done: 3"></span><span class="stacked-segment series-1" style="width:57.14%" title="Pending: 4"></span></div><span>7</span></div>
  <div class="stacked-row"><span>Auth</span><div class="stacked-track"><span class="stacked-segment series-0" style="width:85.71%" title="Done: 6"></span><span class="stacked-segment series-1" style="width:14.29%" title="Pending: 1"></span></div><span>7</span></div>
<div class="stacked-legend"><span><i class="series-0"></i>Done</span><span><i class="series-1"></i>Pending</span></div>
</div>
      <figcaption class="diagram-summary">The total is seven items in each area, with different completed shares.</figcaption>
    </figure>

    <figure id="donut-chart" class="diagram-card" data-diagram="donut-chart">
      <h2>Donut chart</h2>
      <p class="diagram-use">Show a whole divided into a few clearly labeled parts.</p>
      <div class="diagram-scroll"><svg class="diagram-canvas" viewBox="0 0 320 180" aria-hidden="true">
        <circle cx="98" cy="90" r="52" fill="none" stroke="var(--a12)" stroke-width="24"/>
        <circle cx="98" cy="90" r="52" fill="none" stroke="var(--accent)" stroke-width="24" stroke-dasharray="171.5 155.2" transform="rotate(-90 98 90)"/>
        <circle cx="98" cy="90" r="52" fill="none" stroke="var(--a40)" stroke-width="24" stroke-dasharray="98 228.7" stroke-dashoffset="-171.5" transform="rotate(-90 98 90)"/>
        <text class="diagram-value" x="98" y="94">core 52%</text>
        <rect x="182" y="46" width="12" height="12" rx="2" fill="var(--accent)"/><text class="diagram-label is-small" x="240" y="52">core · 52%</text>
        <rect x="182" y="82" width="12" height="12" rx="2" fill="var(--a40)"/><text class="diagram-label is-small" x="240" y="88">support · 30%</text>
        <rect x="182" y="118" width="12" height="12" rx="2" fill="var(--a12)"/><text class="diagram-label is-small" x="240" y="124">other · 18%</text>
      </svg></div>
      <figcaption class="diagram-summary">Core work accounts for 52% of the supplied total, followed by support at 30%.</figcaption>
    </figure>

    <figure id="state-machine" class="diagram-card" data-diagram="state-machine">
      <h2>State machine</h2>
      <p class="diagram-use">Finite states and the events that transition between them.</p>
      <!-- GENERATED from report helpers by diagram-examples.mjs -->
      <div data-component="flow-diagram" class="flow-diagram-wrap"><svg class="flow-diagram" viewBox="0 0 588 182" style="min-width:588px" aria-hidden="true"><defs><marker id="dots-state-2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10Z" fill="var(--a40)"/></marker></defs><path class="flow-edge" d="M144,48 H189 V48 H228" marker-end="url(#dots-state-2-arrow)"/><text class="flow-edge-label" x="189" y="40">check</text><path class="flow-edge" d="M354,48 H399 V48 H438" marker-end="url(#dots-state-2-arrow)"/><text class="flow-edge-label" x="399" y="40">ship</text><rect class="flow-node-rect" x="24" y="24" width="120" height="48" rx="8"/><text class="flow-node-label" x="84" y="48">draft</text><rect class="flow-node-rect is-emphasized" x="234" y="24" width="120" height="48" rx="8"/><text class="flow-node-label" x="294" y="48">verified</text><rect class="flow-node-rect" x="444" y="24" width="120" height="48" rx="8"/><text class="flow-node-label" x="504" y="48">live</text></svg></div><p class="flow-caption">A draft becomes verified after its check and moves live through publication.</p>
    </figure>

    <figure id="timeline" class="diagram-card" data-diagram="timeline">
      <h2>Timeline</h2>
      <p class="diagram-use">Milestones where order and elapsed time carry meaning.</p>
      <!-- GENERATED from report helpers by diagram-examples.mjs -->
