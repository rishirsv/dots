{
  "schemaVersion": 1,
  "server": "portal",
  "version": "0.1.0",
  "tools": [
    {
      "name": "status",
      "description": "Show permitted device/workspace/job health, actual permissions and unavailable dependencies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "open_workspace",
      "description": "Open a read or coordinated write context inside an existing locally approved root. Never approves new roots.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "rootAlias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          }
        },
        "required": [
          "deviceId",
          "rootAlias",
          "access",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "discover",
      "description": "Find up to ten relevant capabilities or skills without loading all schemas/bodies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "query": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "capabilities",
              "skills",
              "all"
            ]
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "query",
          "kind"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "describe",
      "description": "Get focused schemas/type declarations or skill metadata for up to eight exact IDs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "maxItems": 8,
            "minItems": 0
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "maxItems": 8,
            "minItems": 0
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "load_skill",
      "description": "Read one approved skill body or reference with provenance and exact source digest; never executes scripts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "skillId": {
            "type": "string",
            "maxLength": 120
          },
          "expectedHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Root-relative UTF-8 path. No traversal or symlinks. Use . for the root."
          }
        },
        "required": [
          "workspaceId",
          "skillId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_file",
      "description": "Read exact bounded file lines or bytes; preserve its SHA before editing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Root-relative UTF-8 path. No traversal or symlinks. Use . for the root."
          },
          "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxLines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "startByte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "tailLines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "workspaceId",
          "path"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "apply_patch",
      "description": "Apply a focused Codex-style patch with explicit source/absence preconditions and durable per-file receipts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "patch": {
            "type": "string",
            "maxLength": 524288
          },
          "expectedSha256": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxProperties": 100
          }
        },
        "required": [
          "workspaceId",
          "idempotencyKey",
          "patch",
          "expectedSha256"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "exec_command",
      "description": "Start a durable sandboxed command once, then poll its job. Nonzero exit is a command result, not transport failure.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192
            },
            "maxItems": 256,
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Root-relative UTF-8 path. No traversal or symlinks. Use . for the root."
          },
          "executionAccess": {
            "type": "string",
            "enum": [
              "inherit",
              "read"
            ]
          },
          "tty": {
            "type": "boolean"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cols": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            },
            "maxProperties": 20
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 86400000
          },
          "yieldMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          }
        },
        "required": [
          "workspaceId",
          "idempotencyKey",
          "argv",
          "cwd"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "write_stdin",
      "description": "Send explicit stdin or EOF once to an existing interactive command.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          },
          "base64": {
            "type": "string",
            "maxLength": 90000
          },
          "closeStdin": {
            "type": "boolean"
          }
        },
        "required": [
          "workspaceId",
          "idempotencyKey",
          "jobId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_operation",
      "description": "Recover by operationId OR workspaceId plus original idempotencyKey. Never replay an uncertain effect with a new key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_output",
      "description": "Read committed output using an independent cursor; two readers never consume each other’s position.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "waitMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "workspaceId",
          "jobId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cancel_job",
      "description": "Persist cancellation intent and distinguish it from confirmed termination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          }
        },
        "required": [
          "workspaceId",
          "idempotencyKey",
          "jobId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "view_image",
      "description": "Return actual MCP image content from a bounded authorized rendition.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Root-relative UTF-8 path. No traversal or symlinks. Use . for the root."
          },
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "maxEdge": {
            "type": "integer",
            "minimum": 64,
            "maximum": 2048
          },
          "crop": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "run_code_read",
      "description": "Compose selected read capabilities in QuickJS using portal.<family>.<method>; no mutation, spawn, stdin, network or host APIs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "code": {
            "type": "string",
            "maxLength": 65536
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z]+(?:.[a-z_]+)+$"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "limits": {
            "type": "object",
            "properties": {
              "wallMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300000
              },
              "maxCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "workspaceId",
          "code",
          "capabilityIds"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "run_code",
      "description": "Compose selected capabilities in QuickJS; each side effect needs a stable stepKey and ordinary broker permission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "code": {
            "type": "string",
            "maxLength": 65536
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z]+(?:.[a-z_]+)+$"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "limits": {
            "type": "object",
            "properties": {
              "wallMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300000
              },
              "maxCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "workspaceId",
          "writerEpoch",
          "idempotencyKey",
          "code",
          "capabilityIds"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "invoke",
      "description": "Invoke an exact discovered capability/revision with validated arguments. Worst-case mutating and network capable; policy is enforced per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "writerEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "capabilityId": {
            "type": "string",
            "maxLength": 120
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "description": "Bounded JSON value; no functions or prototype-control keys."
            },
            "maxProperties": 100
          }
        },
        "required": [
          "workspaceId",
          "capabilityId",
          "revision",
          "arguments"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "close_workspace",
      "description": "Close only this workspace. Refuse while jobs run, or explicitly request drain/cancel; keep the agent paired.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:@/+-]+$"
          },
          "behavior": {
            "type": "string",
            "enum": [
              "refuse_if_busy",
              "drain",
              "cancel"
            ]
          },
          "report": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "workspaceId",
          "idempotencyKey",
          "behavior"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ]
}
