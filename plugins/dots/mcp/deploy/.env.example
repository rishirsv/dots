# COPY to a private, ignored deploy/.env. Do not commit populated credentials.
PORTAL_HOST=portal.your-owned-domain.example
ACME_EMAIL=owner@example.com
POSTGRES_PASSWORD=REPLACE_WITH_LONG_UNIQUE_VALUE
# URL-encode special characters in the PostgreSQL password component.
DATABASE_URL=postgresql://portal:REPLACE_WITH_LONG_UNIQUE_VALUE@postgres:5432/portal
OAUTH_ISSUER=https://YOUR_TENANT.auth0.com/
OAUTH_AUDIENCE=https://portal.your-owned-domain.example
OAUTH_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
OAUTH_AUTHORIZATION_ENDPOINT=https://YOUR_TENANT.auth0.com/authorize
OAUTH_TOKEN_ENDPOINT=https://YOUR_TENANT.auth0.com/oauth/token
OWNER_CLIENT_ID=REPLACE_WITH_OWNER_WEB_APPLICATION_CLIENT_ID
OWNER_CLIENT_SECRET=REPLACE_WITH_OWNER_WEB_APPLICATION_SECRET
