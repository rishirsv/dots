# Ghostty owns terminal rendering; Zsh owns prompt, completion, and history UX.
font-family = SF Mono Terminal
font-size = 15.5
adjust-cell-height = 10%

theme = dark:Catppuccin Mocha,light:Catppuccin Latte
background-opacity = 0.94
background-blur = macos-glass-regular
window-colorspace = display-p3

cursor-style = bar
cursor-style-blink = false

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always
unfocused-split-opacity = 0.85

macos-titlebar-style = tabs

shell-integration = zsh
macos-option-as-alt = true

# Drop-down terminal shown on the active display.
keybind = global:ctrl+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 42%
quick-terminal-screen = main
