{
  "model": "fable",
  "enabledPlugins": {
    "build-ios-apps@steady-app": true,
    "codex@openai-codex": true,
    "dots@dots": true,
    "meta-skill@dots": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "dots": {
      "source": {
        "source": "directory",
        "path": "/Users/rishi/Code/dots"
      }
    },
    "steady-app": {
      "source": {
        "source": "directory",
        "path": "/Users/rishi/.claude/plugins/local-marketplaces/steady-app"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "enableRemoteControl": false
}
