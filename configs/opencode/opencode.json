{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/x-preview-f-free",
  "permission": "allow",
  "mcp": {
    "reddit-search": {
      "type": "local",
      "command": [
        "node",
        "/Users/rishi/Code/dots/plugins/pulse/server/dist/index.cjs"
      ],
      "enabled": true
    },
    "x-search": {
      "type": "local",
      "command": [
        "node",
        "/Users/rishi/Code/dots/plugins/pulse/server/x-search/server/dist/index.js"
      ],
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "xcodebuildmcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "environment": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,debugging,logging"
      },
      "enabled": true,
      "timeout": 120000
    }
  }
}
