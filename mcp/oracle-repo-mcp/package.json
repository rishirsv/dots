{
  "name": "oracle-repo-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal macOS repository MCP for Oracle consultations, using Codex tool conventions.",
  "license": "MIT",
  "bin": {
    "oracle-repo-mcp": "dist/cli.js",
    "oracle-repo": "dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "build:native": "swiftc native/keychain.swift -o native/keychain-helper",
    "install:tunnel": "node scripts/install-tunnel.mjs",
    "verify:cli": "node scripts/verify-cli.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "node-pty": "1.1.0",
    "sharp": "^0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
